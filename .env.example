# AI provider: "openrouter" (existing cloud setup) or "ollama" (local model)
AI_PROVIDER=openrouter

# For local Ollama on the same computer:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen3:4b

# Existing OpenRouter configuration:
OPENROUTER_API_KEY=
